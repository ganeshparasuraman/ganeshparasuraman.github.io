{
  "required": [
    "title",
    "slug",
    "author",
    "status",
    "category",
    "tags",
    "publishTargets"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 5
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "author": {
      "type": "string"
    },
    "status": {
      "enum": [
        "DRAFT",
        "REWRITTEN",
        "REVIEW_REQUIRED",
        "APPROVED",
        "PUBLISHED_ANGULAR",
        "PUBLISHED_MEDIUM",
        "FAILED"
      ]
    },
    "category": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10
    },
    "summary": {
      "type": "string"
    },
    "canonicalUrl": {
      "type": "string"
    },
    "publishTargets": {
      "properties": {
        "angular": {
          "type": "boolean"
        },
        "medium": {
          "type": "boolean"
        }
      }
    },
    "seo": {
      "properties": {
        "metaTitle": {
          "type": "string"
        },
        "metaDescription": {
          "type": "string",
          "maxLength": 160
        },
        "keywords": {
          "type": "array"
        }
      }
    },
    "tile": {
      "description": "Presentation metadata mapped into the BLOGS array (src/app/shared/blogs.ts).",
      "properties": {
        "icon": {
          "type": "string",
          "description": "Material icon name used in the nav dropdown."
        },
        "faIcon": {
          "type": "string",
          "description": "Font Awesome classes used on the home tile, e.g. 'fa-solid fa-robot'."
        },
        "readTime": {
          "type": "string",
          "description": "e.g. '6 min read'."
        },
        "gradient": {
          "type": "string",
          "description": "CSS gradient for the card banner, e.g. 'linear-gradient(135deg, #1A73E8, #34A853)'."
        },
        "blurb": {
          "type": "string",
          "description": "Short card description shown under the title."
        }
      }
    }
  }
}